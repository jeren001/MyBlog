<%- include("../partials/head") %>
<%- include("../partials/header") %>

<section class="page-header">
  <div>
    <p class="eyebrow">Content Module</p>
    <h1>Article Management</h1>
    <p class="lead">Create, filter, edit, and remove blog posts from a single view.</p>
  </div>
  <a class="button" href="/articles/new">New Article</a>
</section>

<section class="card filter-card">
  <form class="filter-form" method="GET" action="/articles">
    <label>
      <span>Search</span>
      <input
        type="search"
        name="search"
        value="<%= filters.search %>"
        placeholder="Search title, excerpt, or content"
      />
    </label>

    <label>
      <span>Category</span>
      <select name="categoryId">
        <option value="">All categories</option>
        <% categories.forEach((category) => { %>
          <option
            value="<%= category.id %>"
            <%= String(filters.categoryId) === String(category.id) ? "selected" : "" %>
          >
            <%= category.name %>
          </option>
        <% }) %>
      </select>
    </label>

    <div class="filter-actions">
      <button class="button" type="submit">Apply Filters</button>
      <a class="button button-secondary" href="/articles">Reset</a>
    </div>
  </form>
</section>

<section class="article-grid">
  <% if (!articles.length) { %>
    <article class="card empty-state-card">
      <p class="empty-state">No articles match the current filters.</p>
    </article>
  <% } else { %>
    <% articles.forEach((article) => { %>
      <article class="card article-card">
        <div class="meta-line">
          <span><%= article.category_name || "Uncategorized" %></span>
          <span><%= article.comment_count %> comments</span>
        </div>

        <h2>
          <a href="/articles/<%= article.id %>"><%= article.title %></a>
        </h2>

        <p><%= article.excerpt || "No excerpt provided for this article yet." %></p>

        <div class="meta-line meta-line-secondary">
          <span><%= article.reading_time %> min read</span>
          <span><%= article.published_at %></span>
        </div>

        <div class="card-actions">
          <a class="button button-secondary" href="/articles/<%= article.id %>">View</a>
          <a class="button button-secondary" href="/articles/<%= article.id %>/edit">Edit</a>
          <form method="POST" action="/articles/<%= article.id %>?_method=DELETE">
            <button class="button button-danger" data-confirm="Delete this article?" type="submit">
              Delete
            </button>
          </form>
        </div>
      </article>
    <% }) %>
  <% } %>
</section>

<%- include("../partials/footer") %>
